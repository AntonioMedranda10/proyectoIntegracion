{
  "info": {
    "name": "Práctica 3.1 – Comunicación asíncrona (Yeiker Lopez)",
    "description": "Notificación de pedidos con productor (API Laravel), cola (RabbitMQ) y consumidor (php artisan notificaciones:consumir).\n\nAntes de ejecutar: docker compose up -d, php artisan mensajeria:preparar, php artisan serve y, en otra terminal, php artisan notificaciones:consumir (ver README).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "messageId1001",
      "value": ""
    },
    {
      "key": "messageIdDetenido",
      "value": ""
    },
    {
      "key": "messageId1004",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Asíncrono – mensaje válido (pedido 1001)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 202 Accepted (recibido, todavía no procesado)', () => pm.response.to.have.status(202));",
              "const r = pm.response.json();",
              "pm.test('Estado en_cola y enlace para consultar', () => {",
              "  pm.expect(r.estado).to.eql('en_cola');",
              "  pm.expect(pm.response.headers.get('Location')).to.eql(r.consultarEstado);",
              "});",
              "pm.test('Preserva el correlation_id enviado', () => pm.expect(r.correlationId).to.eql('pedido-1001-confirmacion'));",
              "pm.test('Devuelve el correlation_id en la cabecera', () => pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql(r.correlationId));",
              "pm.collectionVariables.set('messageId1001', r.messageId);",
              "console.log('Respuesta inicial asíncrona:', pm.response.responseTime, 'ms');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "description": "El productor valida, publica en la cola notificaciones.pedidos y responde 202 sin esperar el envío.",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "pedido-1001-confirmacion"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pedidoId\": 1001,\n  \"evento\": \"pedido_confirmado\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{api}}/api/v1/notificaciones/pedidos"
      }
    },
    {
      "name": "2. Asíncrono – mensaje válido (pedido 1002)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 202 Accepted (recibido, todavía no procesado)', () => pm.response.to.have.status(202));",
              "const r = pm.response.json();",
              "pm.test('Estado en_cola y enlace para consultar', () => {",
              "  pm.expect(r.estado).to.eql('en_cola');",
              "  pm.expect(pm.response.headers.get('Location')).to.eql(r.consultarEstado);",
              "});",
              "pm.test('Genera un correlation_id (UUID)', () => pm.expect(r.correlationId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/));",
              "pm.test('Devuelve el correlation_id en la cabecera', () => pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql(r.correlationId));",
              "pm.collectionVariables.set('messageId1002', r.messageId);",
              "console.log('Respuesta inicial asíncrona:', pm.response.responseTime, 'ms');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "description": "Sin cabecera X-Correlation-ID: la API genera uno.",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pedidoId\": 1002,\n  \"evento\": \"pedido_enviado\"\n}",
          "options": {
            "raw": {
              "language": "json"
