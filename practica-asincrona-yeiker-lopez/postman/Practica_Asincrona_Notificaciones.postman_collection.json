            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Estado en_cola (detenido) o enviada (reanudado)', () => pm.expect(pm.response.json().estado).to.be.oneOf(['en_cola', 'enviada']));",
              "console.log('Estado actual:', pm.response.json().estado);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
