    {
      "name": "4. Estado del mensaje 1 (tabla de estados)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Mismo correlation_id que la petición 1', () => pm.expect(pm.response.json().correlationId).to.eql('pedido-1001-confirmacion'));",
              "pm.test('El consumidor lo procesó (enviada)', () => pm.expect(pm.response.json().estado).to.eql('enviada'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "description": "Envíela unos segundos después de la petición 1: el consumidor ya debe haberlo procesado (estado enviada).",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{api}}/api/v1/notificaciones/{{messageId1001}}"
      }
    },
    {
      "name": "5. Síncrono – mismo proceso (pedido 1001)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 cuando el envío YA terminó', () => pm.response.to.have.status(200));",
              "pm.test('Estado enviada, modo sincrono', () => {",
              "  pm.expect(pm.response.json().estado).to.eql('enviada');",
              "  pm.expect(pm.response.json().modo).to.eql('sincrono');",
              "});",
              "pm.test('El cliente esperó todo el procesamiento (más de 2 s)', () => pm.expect(pm.response.responseTime).to.be.above(2000));",
              "console.log('Respuesta síncrona:', pm.response.responseTime, 'ms');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "description": "Versión síncrona para comparar: hace el envío dentro de la petición. El cliente espera unos 2 s.",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
