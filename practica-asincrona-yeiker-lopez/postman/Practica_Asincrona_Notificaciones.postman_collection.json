            "key": "X-Correlation-ID",
            "value": "sincrono-1001"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pedidoId\": 1001,\n  \"evento\": \"pedido_confirmado\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{api}}/api/v1/notificaciones/pedidos/sincrono"
      }
    },
    {
      "name": "6. Consumidor detenido – publicar (pedido 1002)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 202 Accepted (recibido, todavía no procesado)', () => pm.response.to.have.status(202));",
