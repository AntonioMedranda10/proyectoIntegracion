          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Explica el motivo', () => pm.expect(pm.response.json().message).to.eql(\"Credenciales inválidas.\"));"
                ]
