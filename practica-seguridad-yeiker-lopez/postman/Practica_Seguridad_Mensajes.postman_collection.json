              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{correo_ana}}\",\n  \"password\": \"clave-equivocada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
