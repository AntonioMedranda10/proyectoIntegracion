          "mode": "raw",
          "raw": "{\n  \"nombre_producto\": \"Parlante portátil\",\n  \"descripcion\": \"Resistente al agua, 12 h de batería\",\n  \"precio\": \"35.50\",\n  \"existencias\": \"20\",\n  \"categoria\": \"Electrónica\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
