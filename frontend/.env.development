# Dirección de NGINX (L1), el único punto de entrada del sistema.
# `npm run dev` reenvía /api y /files a esta dirección (proxy de Vite): el
# navegador usa rutas relativas y no necesita CORS.
NGINX_URL=http://192.168.56.10

# Base que usa el navegador. Vacía = rutas relativas (/api y /files), lo correcto
# con el proxy. Solo ponla (http://<IP de L1>) si quieres saltarte el proxy;
# en ese caso NGINX debe permitir CORS.
VITE_BASE_URL=

# Para probar sin NGINX (backend en tu PC) usa .env.development.local con:
#   NGINX_URL=http://localhost:3001
# Ese archivo tiene prioridad sobre este y no se sube al repositorio.
