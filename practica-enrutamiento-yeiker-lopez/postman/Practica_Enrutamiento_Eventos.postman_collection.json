{
  "info": {
    "name": "Práctica 3.2 – Enrutamiento y filtrado (Yeiker Lopez)",
    "description": "POST /api/v1/eventos: validación → Message Filter → Content-Based Router → cola de RabbitMQ del consumidor.\nAntes de ejecutar: docker compose up -d, php artisan mensajeria:preparar, php artisan serve y los tres consumidores (php artisan eventos:consumir facturacion | logistica | inventario), cada uno en su terminal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "id_pago",
      "value": ""
    },
    {
      "key": "id_despacho",
      "value": ""
    },
    {
      "key": "id_cancelacion",
      "value": ""
    },
    {
      "key": "id_desconocido",
      "value": ""
    },
    {
      "key": "id_prueba",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Caso 1 – pago_aprobado → Facturación",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('id_pago', Number(String(Date.now()).slice(-8)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 202 Accepted', () => pm.response.to.have.status(202));",
              "pm.test('Decisión: enrutado', () => pm.expect(pm.response.json().decision).to.eql('enrutado'));",
              "pm.test('Regla R1 → cola tienda.facturacion', () => {",
              "  pm.expect(pm.response.json().regla).to.eql('R1');",
              "  pm.expect(pm.response.json().cola).to.eql('tienda.facturacion');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "description": "Debe aparecer SOLO en la terminal del consumidor de facturación.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "pedido-1001-pago"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{id_pago}},\n  \"tipo\": \"pago_aprobado\",\n  \"prioridad\": \"alta\",\n  \"datos\": {\n    \"pedido_id\": 1001,\n    \"monto\": 45.9,\n    \"metodo\": \"tarjeta\",\n    \"modo\": \"real\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{api}}/eventos"
      }
    },
    {
      "name": "Caso 2 – pedido_despachado → Logística",
      "event": [
        {
          "listen": "prerequest",
          "script": {
