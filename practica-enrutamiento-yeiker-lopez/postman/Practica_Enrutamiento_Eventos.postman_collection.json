            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "pedido-1002-despacho"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{id_despacho}},\n  \"tipo\": \"pedido_despachado\",\n  \"prioridad\": \"normal\",\n  \"datos\": {\n    \"pedido_id\": 1002,\n    \"transportista\": \"Servientrega\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{api}}/eventos"
      }
    },
