      "name": "Caso 3 – pedido_cancelado → Inventario",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('id_cancelacion', Number(String(Date.now()).slice(-8)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 202 Accepted', () => pm.response.to.have.status(202));",
              "pm.test('Decisión: enrutado', () => pm.expect(pm.response.json().decision).to.eql('enrutado'));",
              "pm.test('Regla R3 → cola tienda.inventario', () => {",
