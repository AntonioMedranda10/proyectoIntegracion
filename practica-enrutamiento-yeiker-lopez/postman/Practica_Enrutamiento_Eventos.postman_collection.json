            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 202 Accepted', () => pm.response.to.have.status(202));",
              "pm.test('Decisión: enrutado', () => pm.expect(pm.response.json().decision).to.eql('enrutado'));",
              "pm.test('Regla R2 → cola tienda.logistica', () => {",
              "  pm.expect(pm.response.json().regla).to.eql('R2');",
              "  pm.expect(pm.response.json().cola).to.eql('tienda.logistica');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "description": "Debe aparecer SOLO en la terminal del consumidor de logística.",
        "header": [
