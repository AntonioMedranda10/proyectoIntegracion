# ---------- Instancia ----------
PORT=3001
INSTANCE_NAME=backend-1

# ---------- Base de datos (L4 - PostgreSQL) ----------
# Desarrollo: Postgres de docker-compose (puerto 5434). Prueba real: IP de L4 y puerto 5432.
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=ecommerce_dev
# true = crea/actualiza las tablas y el usuario admin al arrancar (solo en UNA instancia)
DB_SYNC=true

# ---------- Autenticación ----------
# Las dos instancias deben usar el MISMO secreto
JWT_SECRET=cambia-este-secreto-por-uno-largo
JWT_EXPIRES_SECONDS=86400
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=Admin123!

# ---------- Archivos (L5) ----------
# local  = guarda en la carpeta UPLOADS_DIR (desarrollo, sin L5)
# remote = envía los archivos al servidor de archivos por HTTP
FILES_MODE=local
UPLOADS_DIR=uploads
FILES_URL=http://192.168.10.15
FILES_UPLOAD_PATH=/upload
FILES_HEALTH_PATH=/
